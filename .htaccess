# Arcadia — Apache config for cPanel hosting.

# Short build links: /b/x7k2p is handled by the app, which fetches the build
# by id. Serving index.html directly (rather than redirecting) keeps the short
# URL in the address bar.
RewriteEngine On
RewriteRule ^b/([A-Za-z0-9]{4,12})/?$ /index.html [L]

# Belt and braces: this host happens to block dotfiles already, but don't rely
# on a host default to keep the repository metadata off the web.
RedirectMatch 404 /\.git(/|$)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Never expose database credentials, even if PHP is misconfigured.
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|example\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Self-contained: screenshot OCR loads Tesseract from /vendor/tesseract on this
  # host (no CDN). Recognition still needs a few CSP exceptions that apply only
  # to first-party assets:
  #   script-src  'wasm-unsafe-eval'  compiling the OCR wasm counts as evaluating
  #                                   script. Narrower than plain 'unsafe-eval',
  #                                   which would also re-open eval() / new Function.
  #   worker-src  'self' blob:        worker.min.js from this host, plus the blob
  #                                   wrapper tesseract builds around it.
  #   connect-src data:               the wasm core arrives as a data: URI inside
  #                                   the .wasm.js glue and is read with fetch().
  #                                   data: is not covered by 'self'.
  #   img-src     blob:               preview thumbnail before you confirm an import
  #
  # font-src needs data: because the webfonts are embedded in the page rather
  # than fetched — without it they fall back to default-src 'self', which does
  # not cover data: URIs, and every heading silently renders in a fallback face.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# OCR language packs are already gzip-compressed payloads. If Apache treats the
# .gz suffix as Content-Encoding, the browser decompresses once and Tesseract
# tries to gunzip again — recognition then hangs or fails. Serve them raw.
<FilesMatch "\.traineddata\.gz$">
  RemoveEncoding .gz
  ForceType application/octet-stream
</FilesMatch>
AddType application/wasm .wasm

<IfModule mod_expires.c>
  ExpiresActive On
  # index.html changes whenever the tool is updated, so don't cache it hard.
  ExpiresByType text/html "access plus 0 seconds"
  # OCR assets are versioned by path and rarely change — let browsers keep them.
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/wasm "access plus 30 days"
</IfModule>
